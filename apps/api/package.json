{
  "name": "@telme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run src",
    "test:integration": "vitest run test/health.integration.test.ts test/m5.integration.test.ts test/stabilization.integration.test.ts",
    "typecheck": "pnpm --filter @telme/auth build && pnpm --filter @telme/contracts build && pnpm --filter @telme/device-adapters build && pnpm --filter @telme/genieacs-client build && pnpm --filter @telme/persistence build && tsc --noEmit -p tsconfig.json",
    "admin:create": "tsx src/admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@telme/auth": "workspace:*",
    "@telme/contracts": "workspace:*",
    "@telme/device-adapters": "workspace:*",
    "@telme/device-model": "workspace:*",
    "@telme/genieacs-client": "workspace:*",
    "@telme/persistence": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2"
  }
}
