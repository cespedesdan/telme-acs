{
  "name": "@telme/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @telme/auth build && pnpm --filter @telme/device-model build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@telme/auth": "workspace:*",
    "@telme/device-model": "workspace:*"
  }
}
