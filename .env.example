# Aplicacoes locais
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3101
API_INTERNAL_URL=http://127.0.0.1:3101
WEB_HOST=127.0.0.1
WEB_PORT=3000
SESSION_SECRET=replace_with_at_least_32_random_bytes
OPERATION_TTL_SECONDS=86400
DEVICE_ONLINE_WINDOW_SECONDS=300
DEVICE_OFFLINE_WINDOW_SECONDS=86400

# Bootstrap explícito do primeiro operador: pnpm admin:create
TELME_ADMIN_EMAIL=admin@telme.local
TELME_ADMIN_DISPLAY_NAME=Administrador TELME
TELME_ADMIN_PASSWORD=replace_with_a_strong_local_password
TELME_ADMIN_ROLE=ADMIN

# PostgreSQL (mantenha POSTGRES_PASSWORD e DATABASE_URL sincronizados)
POSTGRES_USER=telme_acs
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_DB=telme_acs
POSTGRES_PORT=5432
DATABASE_URL=postgresql://telme_acs:replace_with_local_postgres_password@127.0.0.1:5432/telme_acs?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# MongoDB privado do GenieACS. Use somente caracteres seguros para URL na senha.
MONGO_INITDB_ROOT_USERNAME=genieacs
MONGO_INITDB_ROOT_PASSWORD=replace_with_local_mongo_password

# GenieACS
GENIEACS_UI_JWT_SECRET=replace_with_random_local_jwt_secret
GENIEACS_CWMP_BIND_ADDRESS=127.0.0.1
GENIEACS_CWMP_PORT=7547
GENIEACS_NBI_PORT=7557
GENIEACS_FS_PORT=7567
GENIEACS_UI_PORT=3002
GENIEACS_NBI_URL=http://127.0.0.1:7557
GENIEACS_NBI_USERNAME=
GENIEACS_NBI_PASSWORD=
GENIEACS_REQUEST_TIMEOUT_MS=10000

# IXC (M7, opcional e ainda não utilizado; nunca use credenciais reais aqui)
IXC_BASE_URL=https://ixc.example.invalid
IXC_API_TOKEN=replace_with_ixc_api_token
IXC_REQUEST_TIMEOUT_MS=10000
