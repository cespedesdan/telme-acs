[Unit]
Description=TELME ACS system worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=telme-acs
Group=telme-acs
WorkingDirectory=/opt/telme-acs/apps/worker
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/telme-acs/apps/worker/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
