# Template only: replace the hostname, certificate paths and access policy.
# Do not enable this listener publicly before restricting test-team access.
server {
    listen 443 ssl;
    server_name acs.example.invalid;

    ssl_certificate /etc/letsencrypt/live/acs.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/acs.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Fail closed: replace with verified team/VPN CIDRs before external tests.
    allow 127.0.0.1;
    allow ::1;
    deny all;

    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
